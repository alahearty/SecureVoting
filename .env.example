# Local PostgreSQL setup (run database/setup-local.ps1).
# The connection string is for the non-superuser securevote_app role.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=securevote;Username=securevote_app;Password=change-me-local
SECUREVOTING_TEST_CONNECTION=Host=localhost;Port=5432;Database=securevote_test;Username=securevote_app;Password=change-me-local

# Docker Compose only (optional; not required for local development)
POSTGRES_PASSWORD=replace-with-a-strong-local-password
SEED_ENABLED=true
SEED_DEMO_PASSWORD=replace-with-a-strong-demo-password
ASPNETCORE_ENVIRONMENT=Development

# Browser-facing port for Docker Compose
API_PORT=8080
FRONTEND_BASE_URL=http://localhost:8080

# Optional SMTP. Leave disabled for the local demonstration.
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
